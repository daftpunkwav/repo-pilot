# Voyager 图谱 C 引擎：超大 tree-sitter grammar 解析器走 Git LFS
services/graph_engine/graph_engine_core/internal/engine/vendored/grammars/**/parser.c filter=lfs diff=lfs merge=lfs -text
services/graph_engine/graph_engine_core/internal/engine/vendored/grammars/**/scanner.c filter=lfs diff=lfs merge=lfs -text
services/graph_engine/graph_engine_core/internal/engine/vendored/grammars/**/scanner.cc filter=lfs diff=lfs merge=lfs -text

# Python 统一 LF 行尾：防止 Windows 编辑器保存为 CRLF 导致整文件 diff 噪音（git blame 被摧毁）
*.py text eol=lf
