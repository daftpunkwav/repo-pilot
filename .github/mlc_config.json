{
  "ignorePatterns": [
    { "pattern": "^node_modules/" },
    { "pattern": "^\\.venv/" },
    { "pattern": "^dist/" },
    { "pattern": "^apps/web/dist/" },
    { "pattern": "package-lock\\.json" }
