{
  "name": "repopilot",
  "private": true,
  "version": "2.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@redocly/openapi-core": {
      "js-yaml": "^4.3.1"
    },
    "postcss": {
      "nanoid": "^3.3.18"
    }
  },
  "scripts": {
    "prepare": "husky",
    "dev:web": "npm run dev -w @repopilot/web",
    "build:web": "npm run build -w @repopilot/web",
    "preview:web": "npm run preview -w @repopilot/web",
    "test:web": "npm run test -w @repopilot/web",
    "test:web:e2e": "npm run test:e2e -w @repopilot/web",
    "lint:web": "npm run lint -w @repopilot/web",
    "typecheck:web": "npm run typecheck -w @repopilot/web",
    "test:api": "pytest tests -q",
    "test": "npm run test:api && npm run test:web",
    "export:openapi": "python scripts/export_openapi.py",
    "generate:types": "npm run export:openapi && npm run generate -w @repopilot/types",
    "lint:py": "ruff check services/",
    "typecheck:py": "mypy services/api/backend",
    "audit:web": "npm audit --audit-level=high",
    "ci": "npm run generate:types && npm run lint:py && npm run typecheck:py && npm run test:api && npm run lint:web && npm run typecheck:web && npm run test:web && npm run audit:web",
    "dev:api": "uvicorn backend.main:app --reload --host 127.0.0.1 --port 19878 --app-dir services/api",
    "dev:agent": "uvicorn agent_runtime.main:app --reload --host 127.0.0.1 --port 19877 --app-dir services/agent"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  },
  "lint-staged": {
    "apps/web/src/**/*.{ts,tsx}": [
      "eslint --max-warnings 0"
    ],
    "services/api/**/*.py": [
      "ruff check --fix"
    ],
    "services/graph_engine/python/**/*.py": [
      "ruff check --fix"
    ],
    ".env": [
      "echo '错误: .env 文件禁止提交,请先从暂存区移除!' && exit 1"
    ],
    ".env.local": [
      "echo '错误: .env.local 文件禁止提交,请先从暂存区移除!' && exit 1"
    ],
    ".env.*.local": [
      "echo '错误: 本地 .env 文件禁止提交,请先从暂存区移除!' && exit 1"
    ]
  }
}
