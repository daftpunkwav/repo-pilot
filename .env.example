# RepoPilot 环境变量示例 —— 复制为仓库根目录 `.env` 后按需修改
# 切勿把含真实密钥的 `.env` 提交入库

# 必填：JWT 签名密钥，长度不少于 32 字节
SECRET_KEY=change-me-to-a-long-random-secret-key

# 建议：与 JWT 分离的敏感字段 at-rest 加密密钥（Fernet 派生）
# SECRETS_ENCRYPTION_KEY=

# 可选：SQLite 路径（默认仓库根 data/repopilot.db）
# DATABASE_URL=sqlite:///./data/repopilot.db

# 开发调试（生产务必 false）
DEBUG=false

# CORS 允许源（逗号分隔）；生产请显式配置前端域名
# CORS_ALLOW_ORIGINS=https://app.example.com

# Cookie：生产默认 Secure+Lax；跨端口本地开发可保持 DEBUG=true
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=lax

# Agent 独立进程（可选）。未设置时 Hub 与 API 同进程。
# AGENT_BASE_URL=http://127.0.0.1:19877
# AGENT_INTERNAL_TOKEN=change-me-agent-internal-token

# 图谱 C 引擎 sidecar（迁入 services/graph_engine/c，默认 :9750）
# 空字符串可强制仅用进程内 Python 回退。
RP_GRAPH_ENGINE_URL=http://127.0.0.1:9750
# RP_GRAPH_ENGINE_BIN=  # 可选；默认找 services/graph_engine/c/build/c/rp-graph-engine*
# RP_GRAPH_CACHE_DIR=   # 可选；默认 data/graph-engine-cache（映射为 CBM_CACHE_DIR）
# RP_GRAPH_ALLOWED_ROOT=
# RP_GRAPH_AUTO_START=true

# 限流
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AGENT=20/minute
